{
  "name": "smart-note",
  "private": true,
  "version": "0.0.1",
  "scripts": {
    "dev": "taro build --type h5 --watch",
    "dev:h5": "taro build --type h5 --watch",
    "build": "taro build --type h5",
    "build:h5": "taro build --type h5",
    "build:weapp": "taro build --type weapp",
    "build:alipay": "taro build --type alipay",
    "android:sync": "npm run build:h5 && cap sync android",
    "android:open": "cap open android",
    "typecheck:core": "tsc -p tsconfig.core.json",
    "preview": "vite preview --outDir dist/h5",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@tarojs/components": "^4.2.1",
    "@tarojs/plugin-framework-react": "^4.2.1",
    "@tarojs/plugin-platform-alipay": "^4.2.1",
    "@tarojs/plugin-platform-h5": "^4.2.1",
    "@tarojs/plugin-platform-weapp": "^4.2.1",
    "@tarojs/react": "^4.2.1",
    "@tarojs/taro": "^4.2.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sql.js": "^1.14.2"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/preset-react": "^7.29.7",
    "@capacitor/cli": "^8.5.2",
    "@pmmmwh/react-refresh-webpack-plugin": "^0.5.17",
    "@tarojs/cli": "^4.2.1",
    "@tarojs/webpack5-runner": "^4.2.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.4.0",
    "@testing-library/react": "^16.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/sql.js": "^1.4.11",
    "@vitejs/plugin-react": "^4.3.0",
    "ajv": "^8.20.0",
    "babel-preset-taro": "^4.2.1",
    "jsdom": "^24.0.0",
    "react-refresh": "^0.14.2",
    "sass": "^1.92.1",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0",
    "webpack": "5.91.0"
  }
